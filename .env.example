# Copy to .env.local for local development. On Vercel, set these in the project settings.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # publishable key of the Supabase project

# The fixed public address of the site. Used for the Google sign-in redirect. Set it on Vercel.
SITE_URL=

# Local development only. The password form on /sign-in. It is ignored on Vercel.
NEXT_PUBLIC_DEV_LOGIN=1

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=                 # used by the daily reminders job
CRON_SECRET=                               # Vercel sends it as "Authorization: Bearer ..."
WHATSAPP_APP_SECRET=                       # the Meta app secret. The webhook checks the signature of every request with it (no secret: 503)
WHATSAPP_VERIFY_TOKEN=                     # any long random text. Meta sends it once, when you set up the webhook
WHATSAPP_TOKEN=                            # the access token of the Meta app
WHATSAPP_PHONE_NUMBER_ID=                  # the id of the business phone number
WHATSAPP_CHANNEL=                          # "simulator" on a developer machine or a test deployment. Leave empty on production
SMS_API_KEY=                               # not used yet: no SMS provider is chosen, so the danger alert records the SMS as failed
RESEND_API_KEY=                            # email reminders (not wired until a sender domain exists)
EMAIL_FROM=                                # a verified sender address
